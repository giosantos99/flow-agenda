{
  "name": "FlowAgenda",
  "version": "0.0.1",
  "description": "Aplicação de agenda para gerenciamento de eventos, desenvolvida com Vue.js e Quasar Framework.",
  "productName": "FlowAgenda",
  "author": "Giovanna Santos de Souza",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "prettier --write \"**/*.{js,vue,css,scss,html,md,json}\" --ignore-path .gitignore && eslint --fix -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "lint:check": "prettier \"**/*.{js,vue,css,scss,html,md,json}\" --ignore-path .gitignore && eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "dev": "quasar dev",
    "api": "json-server --watch db/db.json",
    "dev:all": "concurrently \"npm run dev\" \"npm run api\"",
    "build": "quasar build",
    "postinstall": "quasar prepare --silent"
  },
  "dependencies": {
    "@quasar/extras": "^2.0.4",
    "@quasar/quasar-ui-qcalendar": "^5.2.2",
    "axios": "^1.19.0",
    "json-server": "^1.0.0-beta.15",
    "quasar": "^2.25.1",
    "vue": "^3.5.22",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@quasar/app-vite": "^3.7.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "vite-plugin-checker": "^0.14.5",
    "vue-eslint-parser": "^10.4.0"
  },
  "keywords": [
    "quasar",
    "quasar-app",
    "quasar-cli",
    "quasar-app-vite",
    "vite",
    "vue",
    "vuejs"
  ],
  "engines": {
    "node": ">= 26 || ^24 || ^22.12"
  }
}
